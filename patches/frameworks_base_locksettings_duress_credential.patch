     /**
+     * Key in the lock settings database holding the duress credential as
+     * "&lt;base64 salt&gt;:&lt;base64 PBKDF2-HMAC-SHA256&gt;". Written by org.aox.privacy, which holds
+     * ACCESS_KEYGUARD_SECURE_STORAGE; empty or absent means no duress credential.
+     */
+    private static final String DURESS_KEY = "ax_duress_credential";
+    private static final int DURESS_PBKDF2_ITERATIONS = 10000;
+
+    private boolean isDuressCredential(LockscreenCredential credential, int userId) {
+        final String stored = mStorage.getString(DURESS_KEY, "", userId);
+        if (TextUtils.isEmpty(stored)) {
+            return false;
+        }
+        final String[] parts = stored.split(":");
+        if (parts.length != 2) {
+            return false;
+        }
+        try {
+            final byte[] salt = Base64.decode(parts[0], Base64.NO_WRAP);
+            final byte[] expected = Base64.decode(parts[1], Base64.NO_WRAP);
+            final byte[] actual = SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256")
+                    .generateSecret(new PBEKeySpec(
+                            new String(credential.getCredential(),
+                                    java.nio.charset.StandardCharsets.UTF_8).toCharArray(),
+                            salt, DURESS_PBKDF2_ITERATIONS, expected.length * 8))
+                    .getEncoded();
+            return MessageDigest.isEqual(expected, actual);
+        } catch (GeneralSecurityException | IllegalArgumentException e) {
+            Slog.e(TAG, "Failed to check duress credential", e);
+            return false;
+        }
+    }
+
+    private void wipeForDuress() {
+        Slog.w(TAG, "Duress credential entered, wiping user data");
+        new Thread(() -> {
+            try {
+                android.os.RecoverySystem.rebootWipeUserData(mContext, false /* shutdown */,
+                        "duress", true /* force */, false /* wipeEuicc */);
+            } catch (IOException | SecurityException e) {
+                Slog.e(TAG, "Duress wipe failed", e);
+            }
+        }, "DuressWipe").start();
+    }
