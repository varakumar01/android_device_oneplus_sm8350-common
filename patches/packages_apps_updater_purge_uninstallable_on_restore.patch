diff --git a/app/src/main/java/org/lineageos/updater/controller/UpdaterController.java b/app/src/main/java/org/lineageos/updater/controller/UpdaterController.java
index 2dffccc..e215316 100644
--- a/app/src/main/java/org/lineageos/updater/controller/UpdaterController.java
+++ b/app/src/main/java/org/lineageos/updater/controller/UpdaterController.java
@@ -89,6 +89,15 @@ public class UpdaterController {
         Utils.cleanupDownloadsDir(context);
 
         for (Update update : mUpdatesDbHelper.getUpdates()) {
+            // A row for a build that's already installed (or older than the running one)
+            // can never be started or resumed -- its manifest entry is filtered out by
+            // Utils.isCompatible(), so its download URL is gone for good. Drop it instead
+            // of leaving a dead card behind after an OTA.
+            if (!Update.LOCAL_ID.equals(update.getDownloadId()) && !Utils.canInstall(update)) {
+                Log.d(TAG, update.getDownloadId() + " is no longer installable, removing");
+                deleteUpdateAsync(update);
+                continue;
+            }
             addUpdate(update, false);
         }
     }
