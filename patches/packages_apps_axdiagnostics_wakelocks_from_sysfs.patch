+                activeCount = read("active_count"),
+                eventCount = read("event_count"),
+                wakeupCount = read("wakeup_count"),
+                expireCount = read("expire_count"),
+                activeSinceMs = read("active_time_ms"),
+                totalTimeMs = read("total_time_ms"),
+                maxTimeMs = read("max_time_ms"),
+                lastChangeMs = read("last_change_ms"),
+                preventSuspendTimeMs = read("prevent_suspend_time_ms")
+            )
+        }.orEmpty()
