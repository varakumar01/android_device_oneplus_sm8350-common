<resources>

    <!-- Whether the panel is driven through a Pixelworks Iris5 chip that can do
         motion smoothing (MEMC). Shows the Display category and lets
         IrisMemcService run. -->
    <bool name="config_irisMemcSupported">false</bool>

    <!-- Video player activities (package/class) MEMC is switched on for while
         they are on top. Only the class name is compared. An item without a
         class is a package and matches all of its activities. -->
