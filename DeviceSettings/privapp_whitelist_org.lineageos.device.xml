<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <privapp-permissions package="org.lineageos.device.DeviceSettings">
        <!-- MANAGE_GAME_MODE / GET_TASKS dropped: PowerTools-only (GameSpace
             sync), excluded from this build entirely.
             MODIFY_PHONE_STATE / READ_PHONE_STATE / READ_PRECISE_PHONE_STATE
             dropped here too: only NetworkBandsFragment (band lock, a
             separate commit) needs them; the manifest doesn't request them
             in this base build. -->
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
    </privapp-permissions>
</permissions>
